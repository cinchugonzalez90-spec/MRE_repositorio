<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .serif { font-family: 'Playfair Display', serif; }
        /* Estilos para facilitar la selección en Figma */
        .figma-frame { margin-bottom: 100px; }
    </style>
</head>
<body class="bg-[#F8FAFC] p-20 flex flex-col items-center">

    <!-- FRAME 1: PANTALLA DE LOGIN COMPLETA -->
    <div id="login-frame" class="figma-frame w-[450px] bg-white rounded-[2.5rem] shadow-2xl border border-gray-100 overflow-hidden relative">
        <!-- Tricolor -->
        <div class="w-full h-1.5 flex">
            <div class="flex-1 bg-[#D52B1E]"></div>
            <div class="flex-1 bg-white"></div>
            <div class="flex-1 bg-[#0038A8]"></div>
        </div>

        <div class="p-10">
            <!-- Header -->
            <div class="text-center mb-10">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 mb-4">
                    <div class="w-2 h-2 rounded-full bg-[#D52B1E] animate-pulse"></div>
                    <span class="text-[10px] font-bold text-[#003366] uppercase tracking-tighter">Portal Oficial MRE</span>
                </div>
                <h2 class="text-4xl font-bold text-[#003366] serif mb-2">Bienvenido</h2>
                <p class="text-gray-400 text-sm font-medium">Gestione sus trámites con seguridad.</p>
            </div>

            <!-- Formulario Tradicional -->
            <div class="space-y-5">
                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-gray-500 ml-1">Correo electrónico o número de CI</label>
                    <div class="h-12 bg-gray-50 border border-gray-200 rounded-2xl px-4 flex items-center gap-3">
                        <svg width="18" height="18" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        <span class="text-gray-300 text-sm">Ej: 1.234.567 o su@correo.com</span>
                    </div>
                    <div class="text-right">
                        <span class="text-[10px] font-bold text-[#003366] cursor-pointer hover:underline">¿Olvidó su usuario?</span>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-gray-500 ml-1">Contraseña</label>
                    <div class="h-12 bg-gray-50 border border-gray-200 rounded-2xl px-4 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <svg width="18" height="18" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            <span class="text-gray-300 text-sm">••••••••</span>
                        </div>
                        <svg width="18" height="18" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </div>
                    <div class="text-right">
                        <span class="text-[10px] font-bold text-[#003366] cursor-pointer hover:underline">¿Olvidó su contraseña?</span>
                    </div>
                </div>

                <button class="w-full bg-[#003366] text-white font-bold py-4 rounded-2xl shadow-xl uppercase tracking-widest text-xs mt-2">
                    ACCEDER AL SISTEMA
                </button>
            </div>

            <!-- Separador -->
            <div class="relative my-10 flex items-center gap-4">
                <div class="flex-1 h-px bg-gray-100"></div>
                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest bg-white px-2">OTRAS OPCIONES DE ACCESO</span>
                <div class="flex-1 h-px bg-gray-100"></div>
            </div>

            <!-- Accesos Externos -->
            <div class="space-y-4">
                <button class="w-full bg-white border border-gray-200 py-4 rounded-2xl flex items-center justify-center gap-3 shadow-sm hover:bg-gray-50 transition-all">
                    <div class="w-5 h-5 flex flex-col rounded-sm overflow-hidden">
                        <div class="h-1/3 bg-[#D52B1E]"></div>
                        <div class="h-1/3 bg-white"></div>
                        <div class="h-1/3 bg-[#0038A8]"></div>
                    </div>
                    <span class="text-xs font-bold text-[#003366] uppercase tracking-wider">Identidad Electrónica del Paraguay</span>
                </button>

                <div class="grid grid-cols-2 gap-3">
                    <button class="bg-white border border-gray-200 py-3 rounded-2xl flex items-center justify-center gap-2 text-[10px] font-bold text-gray-600 shadow-sm uppercase">
                        <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.47 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                        GOOGLE
                    </button>
                    <button class="bg-[#1877F2] text-white py-3 rounded-2xl flex items-center justify-center gap-2 text-[10px] font-bold shadow-sm uppercase">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        FACEBOOK
                    </button>
                </div>
            </div>
        </div>

        <div class="bg-gray-50 p-6 text-center border-t border-gray-100">
            <p class="text-xs text-gray-400 font-medium tracking-tight">
                ¿Aún no tiene una cuenta? <span class="text-[#003366] font-bold cursor-pointer hover:underline ml-1">Cree su cuenta aquí</span>
            </p>
        </div>
    </div>

    <!-- FRAME 2: DATOS ADICIONALES -->
    <div id="additional-data-frame" class="figma-frame w-[600px] bg-white rounded-[2.5rem] shadow-2xl border border-gray-100 overflow-hidden relative">
        <div class="w-full h-1.5 flex"><div class="flex-1 bg-[#D52B1E]"></div><div class="flex-1 bg-white"></div><div class="flex-1 bg-[#0038A8]"></div></div>
        <div class="p-12">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold text-[#003366] serif mb-2">Datos adicionales</h2>
                <p class="text-gray-500 text-sm">Complete sus datos adicionales para habilitar su acceso al sistema.</p>
            </div>
            
            <div class="grid grid-cols-2 gap-6 text-left">
                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-gray-500 ml-1">Tipo de documento *</label>
                    <div class="h-12 bg-gray-50 border border-gray-200 rounded-2xl px-4 flex items-center justify-between text-gray-700 text-sm">
                        <span>Cédula Civil</span>
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-gray-500 ml-1">Número de documento *</label>
                    <div class="h-12 bg-gray-50 border border-gray-200 rounded-2xl px-4 flex items-center text-gray-700 text-sm font-medium">
                        1.234.567
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-gray-500 ml-1">Nombre(s) *</label>
                    <div class="h-12 bg-gray-50 border border-gray-200 rounded-2xl px-4 flex items-center text-gray-700 text-sm">Juan Alberto</div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-gray-500 ml-1">Apellido(s) *</label>
                    <div class="h-12 bg-gray-50 border border-gray-200 rounded-2xl px-4 flex items-center text-gray-700 text-sm">Pérez</div>
                </div>
                <div class="col-span-2 space-y-1.5 pt-4">
                    <button class="w-full bg-[#003366] text-white font-bold py-4 rounded-2xl shadow-xl uppercase tracking-widest text-xs">
                        CREAR MI CUENTA
                    </button>
                    <p class="text-center text-[10px] font-bold text-gray-400 mt-4 uppercase tracking-widest cursor-pointer">CANCELAR Y VOLVER AL INICIO</p>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
